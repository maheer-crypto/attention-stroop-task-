                <Param name="pos" val="[0,0]" valType="list" updates="constant" plugin="None"/>
                <Param name="units" val="from exp settings" valType="str" updates="None" plugin="None"/>
                <Param name="ori" val="0" valType="num" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="contrast" val="1" valType="num" updates="constant" plugin="None"/>
                <Param name="validator" val="" valType="code" updates="None" plugin="None"/>
                <Param name="text" val="$word" valType="str" updates="set every repeat" plugin="None"/>
                <Param name="font" val="Arial" valType="str" updates="constant" plugin="None"/>
                <Param name="draggable" val="False" valType="code" updates="constant" plugin="None"/>
                <Param name="letterHeight" val="0.05" valType="num" updates="constant" plugin="None"/>
                <Param name="wrapWidth" val="" valType="num" updates="constant" plugin="None"/>
                <Param name="flip" val="None" valType="str" updates="constant" plugin="None"/>
                <Param name="languageStyle" val="LTR" valType="str" updates="None" plugin="None"/>
            </TextComponent>
            <KeyboardComponent name="practice_key" plugin="None">
                <Param name="name" val="practice_key" valType="code" updates="None" plugin="None"/>
                <Param name="startVal" val="0.5" valType="code" updates="None" plugin="None"/>
                <Param name="startEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="startType" val="time (s)" valType="str" updates="None" plugin="None"/>
                <Param name="stopVal" val="" valType="code" updates="constant" plugin="None"/>
                <Param name="durationEstim" val="" valType="code" updates="None" plugin="None"/>
                <Param name="stopType" val="duration (s)" valType="str" updates="None" plugin="None"/>
                <Param name="forceEndRoutine" val="True" valType="bool" updates="constant" plugin="None"/>
                <Param name="registerOn" val="press" valType="str" updates="constant" plugin="None"/>
                <Param name="allowedKeys" val="'r', 'b', 'g', 'y'" valType="list" updates="constant" plugin="None"/>
                <Param name="store" val="last key" valType="str" updates="constant" plugin="None"/>
                <Param name="storeCorrect" val="True" valType="bool" updates="constant" plugin="None"/>
                <Param name="correctAns" val="$correct_res" valType="str" updates="constant" plugin="None"/>
                <Param name="saveStartStop" val="True" valType="bool" updates="None" plugin="None"/>
                <Param name="syncScreenRefresh" val="True" valType="bool" updates="constant" plugin="None"/>
                <Param name="disabled" val="False" valType="bool" updates="None" plugin="None"/>
                <Param name="discard previous" val="True" valType="bool" updates="constant" plugin="None"/>
            </KeyboardComponent>
        </Routine>
    </Routines>
    <Flow>
        <Routine name="ins"/>
        <LoopInitiator name="trials" plugin="None" loopType="TrialHandler">
            <Param name="name" val="trials" valType="code" updates="None" plugin="None"/>
            <Param name="loopType" val="random" valType="str" updates="None" plugin="None"/>
            <Param name="isTrials" val="True" valType="bool" updates="None" plugin="None"/>
            <Param name="conditionsFile" val="stroop_conditions.xlsx" valType="file" updates="None" plugin="None"/>
            <Param name="nReps" val="1" valType="code" updates="None" plugin="None"/>
            <Param name="Selected rows" val="" valType="code" updates="None" plugin="None"/>
            <Param name="random seed" val="" valType="code" updates="None" plugin="None"/>
            <Param name="conditions" val="[{&quot;word&quot;:&quot;RED&quot;,&quot;colour&quot;:&quot;red&quot;,&quot;stimuli_condition&quot;:&quot;C&quot;,&quot;correct_res&quot;:&quot;r&quot;},{&quot;word&quot;:&quot;RED&quot;,&quot;colour&quot;:&quot;blue&quot;,&quot;stimuli_condition&quot;:&quot;I&quot;,&quot;correct_res&quot;:&quot;b&quot;},{&quot;word&quot;:&quot;BLUE&quot;,&quot;colour&quot;:&quot;red&quot;,&quot;stimuli_condition&quot;:&quot;I&quot;,&quot;correct_res&quot;:&quot;r&quot;},{&quot;word&quot;:&quot;BLUE&quot;,&quot;colour&quot;:&quot;blue&quot;,&quot;stimuli_condition&quot;:&quot;C&quot;,&quot;correct_res&quot;:&quot;b&quot;}]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="trial"/>
        <LoopInitiator name="practice_trials" plugin="None" loopType="TrialHandler">
            <Param name="name" val="practice_trials" valType="code" updates="None" plugin="None"/>
            <Param name="loopType" val="random" valType="str" updates="None" plugin="None"/>
            <Param name="isTrials" val="True" valType="bool" updates="None" plugin="None"/>
            <Param name="conditionsFile" val="stroop_conditions.xlsx" valType="file" updates="None" plugin="None"/>
            <Param name="nReps" val="1" valType="code" updates="None" plugin="None"/>
            <Param name="Selected rows" val="" valType="code" updates="None" plugin="None"/>
            <Param name="random seed" val="" valType="code" updates="None" plugin="None"/>
            <Param name="conditions" val="[]" valType="str" updates="None" plugin="None"/>
            <Param name="endPoints" val="[0,1]" valType="code" updates="None" plugin="None"/>
        </LoopInitiator>
        <Routine name="practice_trial"/>
        <LoopTerminator name="trials"/>
        <LoopTerminator name="practice_trials"/>
        <Routine name="thankyou"/>
    </Flow>
</PsychoPy2experiment>